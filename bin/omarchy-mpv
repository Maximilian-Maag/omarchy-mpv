#!/usr/bin/env python3
"""omarchy-mpv — integrate the installed mpv media player with Omarchy.

The plugin does three things, none of which bake in a colour palette:

* ``theme``  — reads the **applied** Omarchy theme live from
  ``$XDG_STATE_HOME/omarchy/current/theme/colors.toml`` (default
  ``~/.local/state/omarchy/current/theme/colors.toml``) and writes an mpv
  configuration fragment (subtitle / OSD / window colours) to a **dedicated**
  file, ``~/.config/mpv/omarchy-theme.conf`` by default. The user's own
  ``~/.config/mpv/mpv.conf`` is only ever appended to, once, with a guarded
  ``include=`` line, so nothing the user wrote is destroyed.
* ``send``   — drives a **running** mpv over its JSON IPC socket
  (``--input-ipc-server``): play / pause / toggle / next / prev / stop / mute /
  volume. No socket, no crash — a clear message instead.
* ``status`` — reports the applied theme, the generated fragment, the socket and
  the mpv version.

Because every colour comes from the live ``colors.toml`` at runtime, any Omarchy
theme — including one the user wrote — themes mpv correctly.
"""

from __future__ import annotations

import argparse
import json
import os
import pathlib
import re
import socket
import subprocess
import sys

PLUGIN_ID = "Maximilian-Maag.mpv"

HEADER = (
    "# Generated by omarchy-mpv from the applied Omarchy theme.\n"
    "# Do not edit by hand — re-run `omarchy-mpv theme` after a theme change.\n"
    "# Include this from your own mpv config:\n"
    "#   include=~/.config/mpv/omarchy-theme.conf\n"
)

DEFAULT_CONFIG = {
    "theme_conf_path": "mpv/omarchy-theme.conf",
    "socket_path": "omarchy-mpv.sock",
    "keybinding": "SUPER + SHIFT + ALT + M",
}

# Volume nudge used by `send volume-up` / `send volume-down`, in percent.
VOLUME_STEP = 5

# Friendly command names → a raw mpv JSON IPC command (no arguments).
SIMPLE_COMMANDS = {
    "play": ["set_property", "pause", False],
    "pause": ["set_property", "pause", True],
    "toggle": ["cycle", "pause"],
    "play-pause": ["cycle", "pause"],
    "next": ["playlist-next"],
    "prev": ["playlist-prev"],
    "stop": ["stop"],
    "mute": ["cycle", "mute"],
}


def state_home() -> pathlib.Path:
    """Omarchy's state root — where the applied theme lives."""
    return pathlib.Path(os.environ.get("XDG_STATE_HOME") or (pathlib.Path.home() / ".local/state"))


def config_home() -> pathlib.Path:
    """The XDG config root."""
    return pathlib.Path(os.environ.get("XDG_CONFIG_HOME") or (pathlib.Path.home() / ".config"))


def runtime_dir() -> pathlib.Path:
    """Where a per-session IPC socket belongs."""
    return pathlib.Path(os.environ.get("XDG_RUNTIME_DIR") or "/tmp")


def plugin_dir() -> pathlib.Path:
    """This plugin's checkout.

    ``bin/omarchy-mpv`` is installed as a symlink into the repo, and
    ``Path.resolve`` follows it, so this works for both the dev checkout and an
    installed plugin.
    """
    return pathlib.Path(__file__).resolve().parent.parent


def theme_colors_path() -> pathlib.Path:
    """The applied theme's colours.toml (a copy; the name is not in the path)."""
    return state_home() / "omarchy" / "current" / "theme" / "colors.toml"


def theme_search_dirs() -> list[pathlib.Path]:
    """Every installed theme directory, system-wide first then per-user."""
    dirs: list[pathlib.Path] = []
    for root in ("/usr/share/omarchy/themes", str(config_home() / "omarchy" / "themes")):
        base = pathlib.Path(root)
        if base.is_dir():
            dirs.extend(sorted(p for p in base.iterdir() if p.is_dir()))
    return dirs


def load_config(path: pathlib.Path | None = None) -> dict:
    """Read config/mpv.json, falling back to the built-in defaults."""
    path = pathlib.Path(path) if path is not None else (plugin_dir() / "config" / "mpv.json")
    data = dict(DEFAULT_CONFIG)
    if path.is_file():
        try:
            data.update(json.loads(path.read_text()))
        except ValueError:
            pass
    return data


def _resolve_path(raw: str, base: pathlib.Path) -> pathlib.Path:
    """A path that is absolute or starts with ``~`` is used as-is; else under base."""
    if raw.startswith("~") or raw.startswith("/"):
        return pathlib.Path(os.path.expanduser(raw))
    return base / raw


def theme_conf_path(cfg: dict | None = None) -> pathlib.Path:
    """Where the generated mpv theme fragment is written."""
    cfg = cfg if cfg is not None else load_config()
    raw = str(cfg.get("theme_conf_path") or DEFAULT_CONFIG["theme_conf_path"])
    return _resolve_path(raw, config_home())


def socket_path(cfg: dict | None = None, override: str | None = None) -> pathlib.Path:
    """Where mpv's JSON IPC socket lives.

    An explicit ``override`` wins (used by tests and ``--socket``); otherwise the
    configured ``socket_path`` is resolved against the runtime dir.
    """
    if override:
        return pathlib.Path(os.path.expanduser(override))
    cfg = cfg if cfg is not None else load_config()
    raw = str(cfg.get("socket_path") or DEFAULT_CONFIG["socket_path"])
    return _resolve_path(raw, runtime_dir())


def parse_colors(text: str) -> dict:
    """Parse an Omarchy colors.toml into a plain ``{key: value}`` dict.

    Blank lines and ``#`` comments are skipped; surrounding quotes are stripped
    from values. Hex colour values survive because only a line whose *first*
    non-space character is ``#`` counts as a comment.
    """
    colors: dict[str, str] = {}
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if "=" not in line:
            continue
        key, _, value = line.partition("=")
        key = key.strip()
        value = value.strip().strip('"').strip("'")
        if not key:
            continue
        colors[key] = value
    return colors


def normalize_name(name: str) -> str:
    """Omarchy theme names are Title Case; directories are lower-dashed."""
    return name.strip().lower().replace(" ", "-")


def resolve_theme_name(colors: dict, search_dirs: list[pathlib.Path]) -> str:
    """Recover the applied theme's name by matching colours against the themes.

    The applied theme is a *copy*, so its directory is always literally
    ``theme`` and the name is nowhere in the path. Match the colour set against
    each installed theme instead.
    """
    for directory in search_dirs:
        candidate = directory / "colors.toml"
        if not candidate.is_file():
            continue
        if parse_colors(candidate.read_text()) == colors:
            return directory.name
    return ""


def mpv_colour(value: str) -> str:
    """Normalise an Omarchy colour value to something mpv accepts.

    ``#rrggbb`` passes through; a Hyprland ``rgba(rrggbbaa)`` gradient stop is
    reduced to its ``#rrggbb``. Anything else is an error — silently emitting a
    bogus colour would leave mpv rendering a fallback.
    """
    value = value.strip()
    if value.startswith("#") and len(value) == 7:
        return value
    match = re.fullmatch(r"rgba\(([0-9a-fA-F]{6})([0-9a-fA-F]{2})\)", value)
    if match:
        return "#" + match.group(1)
    raise ValueError("unsupported colour: %s" % value)


def theme_pairs(colors: dict) -> list[tuple[str, str]]:
    """The ``(mpv-option, colour)`` pairs the applied theme maps onto.

    Every value is derived from the live colour map — the plugin ships no hex
    literal of its own. ``accent`` drives the OSD *selection* highlight.
    """
    fg = mpv_colour(colors["foreground"])
    bg = mpv_colour(colors["background"])
    accent = mpv_colour(colors["accent"])
    dark = mpv_colour(colors.get("dark_background") or colors["background"])
    return [
        ("sub-color", fg),
        ("sub-outline-color", bg),
        ("sub-back-color", dark),
        ("osd-color", fg),
        ("osd-outline-color", bg),
        ("osd-back-color", bg),
        ("osd-selected-color", accent),
        ("osd-selected-outline-color", bg),
        ("background-color", bg),
    ]


def build_conf(colors: dict) -> str:
    """Render the full mpv theme fragment from an Omarchy colour map."""
    lines = [HEADER.rstrip("\n"), ""]
    for prop, value in theme_pairs(colors):
        # mpv config files treat a bare '#' as a comment, so colour values must
        # be quoted or the value is silently swallowed.
        lines.append('%s="%s"' % (prop, value))
    lines.append("sub-bold=yes")
    return "\n".join(lines) + "\n"


def mpv_version() -> str:
    """The installed mpv version, or a sentinel when it is missing."""
    try:
        out = subprocess.run(["mpv", "--version"], capture_output=True, text=True)
    except (OSError, subprocess.SubprocessError):
        return "not installed"
    first = out.stdout.splitlines()
    return first[0].strip() if first else "unknown"


def ipc_request(sock: pathlib.Path, command: list, timeout: float = 2.0) -> dict:
    """Send one JSON IPC command and return mpv's parsed response."""
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as conn:
        conn.settimeout(timeout)
        conn.connect(str(sock))
        conn.sendall((json.dumps({"command": command}) + "\n").encode())
        reader = conn.makefile("rb")
        line = reader.readline()
    return json.loads(line.decode())


def socket_reachable(sock: pathlib.Path) -> bool:
    """True when a live mpv is listening on the IPC socket."""
    if not os.path.exists(str(sock)):
        return False
    try:
        ipc_request(sock, ["get_property", "mpv-version"])
    except (OSError, ValueError):
        return False
    return True


def resolve_command(name: str, value: str | None = None) -> list | None:
    """Map a friendly command name to a raw mpv IPC command, or None if unknown."""
    if name in SIMPLE_COMMANDS:
        return list(SIMPLE_COMMANDS[name])
    if name == "volume":
        if value is None:
            return ["get_property", "volume"]
        return ["set_property", "volume", float(value)]
    if name == "volume-up":
        return ["add", "volume", VOLUME_STEP]
    if name == "volume-down":
        return ["add", "volume", -VOLUME_STEP]
    return None


def apply_live(cfg: dict, colors: dict, override: str | None = None) -> bool:
    """Push the theme colours to a running mpv over IPC (best effort).

    Returns True when a live mpv was updated, False when none was listening.
    """
    sock = socket_path(cfg, override)
    if not socket_reachable(sock):
        return False
    try:
        for prop, value in theme_pairs(colors):
            ipc_request(sock, ["set_property", prop, value])
    except (OSError, ValueError):
        return False
    return True


def cmd_theme(args) -> int:
    cfg = load_config(args.config)
    colors_path = theme_colors_path()
    if not colors_path.is_file():
        print("omarchy-mpv: no applied theme at %s" % colors_path, file=sys.stderr)
        return 1
    colors = parse_colors(colors_path.read_text())
    conf = build_conf(colors)
    if args.stdout:
        sys.stdout.write(conf)
        return 0
    out = theme_conf_path(cfg)
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(conf)
    print("omarchy-mpv: wrote %s" % out)
    name = resolve_theme_name(colors, theme_search_dirs())
    if name:
        print("omarchy-mpv: applied theme: %s" % name)
    if args.live:
        if apply_live(cfg, colors, args.socket):
            print("omarchy-mpv: applied theme live to the running mpv")
    return 0


def cmd_send(args) -> int:
    cfg = load_config(args.config)
    sock = socket_path(cfg, args.socket)
    command = resolve_command(args.name, args.value)
    if command is None:
        known = ", ".join(sorted(list(SIMPLE_COMMANDS) + ["volume", "volume-up", "volume-down"]))
        print("omarchy-mpv: unknown command '%s' (try: %s)" % (args.name, known), file=sys.stderr)
        return 2
    if not socket_reachable(sock):
        print("omarchy-mpv: no mpv IPC socket at %s — is mpv running with "
              "--input-ipc-server?" % sock, file=sys.stderr)
        return 1
    try:
        response = ipc_request(sock, command)
    except (OSError, ValueError) as exc:
        print("omarchy-mpv: cannot talk to mpv at %s: %s" % (sock, exc), file=sys.stderr)
        return 1
    if response.get("error") != "success":
        print("omarchy-mpv: mpv rejected '%s': %s" % (args.name, response.get("error")),
              file=sys.stderr)
        return 1
    if args.name == "volume" and args.value is None:
        print(response.get("data"))
    return 0


def cmd_bindings(args) -> int:
    src = plugin_dir() / "bin" / "bindings.lua"
    if not src.is_file():
        print("omarchy-mpv: bindings.lua not found at %s" % src, file=sys.stderr)
        return 1
    hypr = config_home() / "hypr"
    hypr.mkdir(parents=True, exist_ok=True)
    dest = hypr / "mpv-bindings.lua"
    dest.write_text(src.read_text())
    require = 'require("hypr.mpv-bindings")'
    main = hypr / "hyprland.lua"
    if main.is_file():
        text = main.read_text()
        if require not in text:
            with main.open("a") as fh:
                fh.write("\n-- omarchy-mpv keybindings\n" + require + "\n")
            print("omarchy-mpv: wired %s into %s" % (require, main))
        else:
            print("omarchy-mpv: keybindings already wired")
    else:
        print("omarchy-mpv: %s not found — add %s" % (main, require))
    print("omarchy-mpv: wrote %s" % dest)
    return 0


def cmd_status(args) -> int:
    cfg = load_config(args.config)
    colors_path = theme_colors_path()
    name = ""
    if colors_path.is_file():
        colors = parse_colors(colors_path.read_text())
        name = resolve_theme_name(colors, theme_search_dirs())
    conf = theme_conf_path(cfg)
    sock = socket_path(cfg, args.socket)
    print("omarchy-mpv %s" % PLUGIN_ID)
    print("applied theme : %s" % (name or "(unknown)"))
    print("colors        : %s%s" % (colors_path, "" if colors_path.is_file() else " (missing)"))
    print("theme conf    : %s%s" % (conf, "" if conf.is_file() else " (not generated)"))
    print("socket        : %s (%s)" % (sock, "running" if socket_reachable(sock) else "not running"))
    print("keybinding    : %s" % cfg.get("keybinding"))
    print("mpv           : %s" % mpv_version())
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="omarchy-mpv", description=__doc__.splitlines()[0])
    parser.add_argument("--config", default=None,
                        help="path to config/mpv.json (default: the plugin's own)")
    parser.add_argument("--socket", default=None,
                        help="mpv IPC socket path (default: from config)")
    sub = parser.add_subparsers(dest="command", required=True)

    theme = sub.add_parser("theme", help="generate the mpv theme fragment from the applied theme")
    theme.add_argument("--stdout", action="store_true", help="print the fragment instead of writing it")
    theme.add_argument("--live", action="store_true",
                       help="also apply the colours to a running mpv over IPC")
    theme.set_defaults(func=cmd_theme)

    send = sub.add_parser("send", help="drive a running mpv over its IPC socket")
    send.add_argument("name", help="play, pause, toggle, next, prev, stop, mute, volume, "
                                   "volume-up, volume-down")
    send.add_argument("value", nargs="?", default=None, help="volume level for 'volume'")
    send.set_defaults(func=cmd_send)

    bindings = sub.add_parser("bindings", help="install the Hyprland keybinding module")
    bindings.set_defaults(func=cmd_bindings)

    status = sub.add_parser("status", help="report the applied theme, fragment and socket")
    status.set_defaults(func=cmd_status)
    return parser


def main(argv=None) -> int:
    args = build_parser().parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
